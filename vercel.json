{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/dashboard",   "destination": "/PurposeChurch_Dashboard.html" },
    { "source": "/qr",          "destination": "/qr.html" },
    { "source": "/qr/sermons",  "destination": "/qr-sermons.html" },
    { "source": "/qr/events",   "destination": "/qr-events.html" },
    { "source": "/qr/give",          "destination": "/qr-give.html" },
    { "source": "/women-of-purpose-retreat", "destination": "/women-of-purpose-retreat.html" }
  ]
}
